{"number":112,"name":"سُورَةُ الإِخۡلَاصِ","englishName":"Al-Ikhlaas","englishNameTranslation":"Sincerity","revelationType":"Meccan","numberOfAyahs":4,"ayahs":[{"number":6222,"numberInSurah":1,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false,"text":{"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ هُوَ ٱللَّهُ أَحَدٌ","translations":{"asad":"SAY: \"He is the One God:","sahih":"Say, \"He is Allah, [who is] One,"}}},{"number":6223,"numberInSurah":2,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false,"text":{"arabic":"ٱللَّهُ ٱلصَّمَدُ","translations":{"asad":"\"God the Eternal, the Uncaused Cause of All Being.","sahih":"Allah, the Eternal Refuge."}}},{"number":6224,"numberInSurah":3,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false,"text":{"arabic":"لَمْ يَلِدْ وَلَمْ يُولَدْ","translations":{"asad":"\"He begets not, and neither is He begotten;","sahih":"He neither begets nor is born,"}}},{"number":6225,"numberInSurah":4,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false,"text":{"arabic":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","translations":{"asad":"\"and there is nothing that could be compared with Him.","sahih":"Nor is there to Him any equivalent.\""}}}]}